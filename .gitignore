# =============================================================================
# CallMate - Root .gitignore
# =============================================================================

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*~
.idea/
*.iml
.vscode/

# Environment, Secrets & Local Credentials (NEVER commit secrets!)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
*.jks

# Logs and Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# Python & Backend (FastAPI / Uvicorn)
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# =============================================================================
# Android & Gradle
# =============================================================================
.gradle/
build/
*/build/
*/*/build/
**/build/

# Android Studio / Gradle Generated files
local.properties
captures/
.externalNativeBuild/
.cxx/

# Android Packaging & Build Outputs
*.apk
*.aab
*.ap_
output-metadata.json
apk/

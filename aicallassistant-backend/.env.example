# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Development CORS Origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,http://10.0.2.2:8000,http://YOUR_LOCAL_IP:8000

# Google Gemini Live API (Backend only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-live
GEMINI_DEFAULT_VOICE=Puck

# Supabase Configuration
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Publishable key (safe for client use)
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Backend administrative key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional JWT Secret
# Leave unset if using asymmetric JWKS verification.
# SUPABASE_JWT_SECRET=your_optional_hs256_jwt_secret_here

# Supabase Storage
SUPABASE_STORAGE_BUCKET=call-recordings